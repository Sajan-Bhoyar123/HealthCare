{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "healthcaredatafactorry"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcarestorageacount.dfs.core.windows.net/"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcare-serverr.database.windows.net"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Healthcare_sql_database"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sajan"
		},
		"LS_Databrick_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1101-121845-n2m3ctqz"
		},
		"LS_Key_Vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://HealthcareKeyVauult.vault.azure.net/"
		},
		"LS_Postgress_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-wandering-mode-b59g4kw2-pooler.c-7.us-east-2.aws.neon.tech"
		},
		"LS_Postgress_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_Postgress_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "healthcaredatafactorry_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_Key_Vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_Key_Vault_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_userName')]"
					},
					"LS_Databrick_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_Databrick_properties_typeProperties_existingClusterId')]"
					},
					"LS_Postgress_properties_typeProperties_server": {
						"value": "[parameters('LS_Postgress_properties_typeProperties_server')]"
					},
					"LS_Postgress_properties_typeProperties_database": {
						"value": "[parameters('LS_Postgress_properties_typeProperties_database')]"
					},
					"LS_Postgress_properties_typeProperties_username": {
						"value": "[parameters('LS_Postgress_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}